/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * native_sim ships only led0 out of the box. Add led1..led3 on the same
 * gpio_emul controller so srvController's LEDs build and run identically to
 * the real board, plus button0..3 (pins 4..7 on the same controller) for
 * myButtonListener.
 */
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

&leds {
	led1: led_1 {
		gpios = <&gpio0 1 GPIO_ACTIVE_HIGH>;
	};

	led2: led_2 {
		gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
	};

	led3: led_3 {
		gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>;
	};
};

/ {
	aliases {
		led1 = &led1;
		led2 = &led2;
		led3 = &led3;
		sw0 = &button0;
		sw1 = &button1;
		sw2 = &button2;
		sw3 = &button3;
	};

	buttons {
		compatible = "gpio-keys";

		button0: button_0 {
			gpios = <&gpio0 4 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_0>;
		};

		button1: button_1 {
			gpios = <&gpio0 5 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_1>;
		};

		button2: button_2 {
			gpios = <&gpio0 6 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_2>;
		};

		button3: button_3 {
			gpios = <&gpio0 7 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_3>;
		};
	};
};
