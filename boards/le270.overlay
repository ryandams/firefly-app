/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * Fibocom LE270 modem wired externally to this DK, on uart21 (SoC PERI
 * domain, P1) - the same physical UART/PWRKEY pins boards/eg800z.overlay
 * uses, since only one external modem is ever populated on the DK at a
 * time:
 *
 *   TXD     - P1.13 (SoC output -> modem MAIN_RXD)
 *   RXD     - P1.14 (SoC input  <- modem MAIN_TXD)
 *   RTS     - P1.11 (SoC output -> modem MAIN_CTS)
 *   CTS     - P1.12 (SoC input  <- modem MAIN_RTS)
 *   PWRKEY   - P0.00 (gpio0, active-low)
 *
 * RESET_N and MAIN_DTR are NOT wired here: on the Fibocom LE270 ADP
 * (development board), both are only exposed as onboard physical
 * buttons, not as header pins the DK can drive. Both are optional per
 * zephyr,cellular-modem-device.yaml (only mdm-power-gpios is
 * `required: true`), so this is a supported configuration, not a
 * workaround:
 *  - mdm-reset-gpios only gates zephyr,mdm-reset-behavior's
 *    "toggle_on_recovery" - an automatic RESET_N pulse if the init chat
 *    script ever fails to get responses. Without it, that one
 *    auto-recovery path is unavailable; the ADP's reset button (or a
 *    full power cycle) still works as a manual fallback.
 *  - mdm-dtr-gpios only matters for DTR-gated sleep. The LE270-EU
 *    datasheet lists PSM as unsupported for this variant, so there is no
 *    low-power sleep mode here for DTR to gate in the first place -
 *    leaving it unwired costs nothing for this project's PPP/UDP round
 *    trip.
 *
 * Unlike the EG800Z, this driver does NOT set `autostarts`: the LE270
 * Hardware Guide V2.2 section 4.2 documents a normal PWRKEY power-on pulse
 * (pull low >=650ms, VBAT stable >=30ms first) as the expected method, with
 * no equivalent to the EG800Z's observed "boots on its own, a PWRKEY pulse
 * turns it back off" behavior - unverified on real hardware, but the
 * documented method is the safer default to start from.
 *
 * Polarity for PWRKEY: Hardware Guide V2.2 section 4.2 - active-LOW (pull
 * low to trigger; idle high via the module's own internal pull-up),
 * matching the EG800Z's own PWRKEY convention.
 */
#include <zephyr/dt-bindings/gpio/gpio.h>

&pinctrl {
	uart21_default_le270: uart21_default_le270 {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 13)>,
				<NRF_PSEL(UART_RTS, 1, 11)>;
		};

		group2 {
			psels = <NRF_PSEL(UART_RX, 1, 14)>,
				<NRF_PSEL(UART_CTS, 1, 12)>;
			bias-pull-up;
		};
	};

	uart21_sleep_le270: uart21_sleep_le270 {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 13)>,
				<NRF_PSEL(UART_RX, 1, 14)>,
				<NRF_PSEL(UART_RTS, 1, 11)>,
				<NRF_PSEL(UART_CTS, 1, 12)>;
			low-power-enable;
		};
	};
};

&uart21 {
	status = "okay";
	pinctrl-0 = <&uart21_default_le270>;
	pinctrl-1 = <&uart21_sleep_le270>;
	pinctrl-names = "default", "sleep";
	current-speed = <115200>;
	hw-flow-control;
	zephyr,pm-device-runtime-auto;

	modem: modem {
		compatible = "fibocom,le270";
		mdm-power-gpios = <&gpio0 0 GPIO_ACTIVE_LOW>;
		zephyr,pm-device-runtime-auto;
	};
};

/ {
	aliases {
		modem = &modem;
	};
};
