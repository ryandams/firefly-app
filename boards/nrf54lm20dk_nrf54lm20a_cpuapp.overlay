/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * srvNetwork: an nRF93M1 module wired externally to this DK (there is no
 * on-board modem here, unlike the nRF93M1 DK). uart30 is free on this board
 * - not claimed by console/LEDs/buttons - and already has hardware-flow-
 * control pinctrl defined by the board itself:
 *
 *   TX  = P0.06   RX  = P0.07   RTS = P0.08   CTS = P0.09
 *
 * mdm-power-gpios/mdm-reset-gpios below are this project's own choice, not
 * anything the nRF93M1 module dictates - rewire to match whatever pins you
 * actually connect POWER_KEY/RESET to. mdm-power-gpios is the only one the
 * "nordic,nrf93m1" binding requires; mdm-reset-gpios is optional but is
 * what the nRF93M1 DK's own reference wiring also uses.
 */
#include <zephyr/dt-bindings/gpio/gpio.h>

&uart30 {
	status = "okay";
	hw-flow-control;
	zephyr,pm-device-runtime-auto;

	modem: modem {
		compatible = "nordic,nrf93m1";
		mdm-power-gpios = <&gpio0 10 GPIO_ACTIVE_HIGH>;
		mdm-reset-gpios = <&gpio0 11 GPIO_ACTIVE_HIGH>;
		zephyr,pm-device-runtime-auto;
	};
};

/ {
	aliases {
		modem = &modem;
	};
};
