menu "Firefly application"

config FIREFLY_PORT_HOST
	bool "Satisfy the port interfaces without hardware"
	default y if BOARD_NATIVE_SIM
	default n
	help
	  Compiles port/host instead of port/mcu. No radio, no BLE stack, no
	  peripheral drivers - the hardware boundary is met on the host side so
	  the mission logic can run anywhere Zephyr runs.

	  This is a HARDWARE switch, not an RTOS switch: Zephyr is linked either
	  way, including on native_sim.

config FIREFLY_LOG_LEVEL
	int "Firefly log level"
	default 3

config FIREFLY_FIX_TIMEOUT_MS
	int "GNSS fix timeout (ms)"
	default 120000

config FIREFLY_REPORT_INTERVAL_S
	int "Nominal reporting interval (s)"
	default 3600

config FIREFLY_BATCH_SIZE
	int "Reports to accumulate before opening a session"
	default 6

config FIREFLY_MAX_BATCH_LATENCY_S
	int "Send regardless after this long (s)"
	default 21600

if FIREFLY_PORT_HOST

config FIREFLY_HOST_TTFF_MS
	int "Simulated time to first fix (ms)"
	default 4000

config FIREFLY_HOST_FIX_FAIL_EVERY
	int "Fail every Nth simulated fix (0 = never)"
	default 4

config FIREFLY_HOST_SESSION_FAILS
	int "Number of simulated session failures before success"
	default 2

endif # FIREFLY_PORT_HOST

endmenu

source "Kconfig.zephyr"
