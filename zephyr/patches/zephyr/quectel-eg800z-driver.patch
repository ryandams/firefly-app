diff --git a/drivers/modem/vendor_modem_cellular/cellular_quectel_eg800z.c b/drivers/modem/vendor_modem_cellular/cellular_quectel_eg800z.c
new file mode 100644
index 00000000000..d1f681f3ea3
--- /dev/null
+++ b/drivers/modem/vendor_modem_cellular/cellular_quectel_eg800z.c
@@ -0,0 +1,134 @@
+/*
+ * Copyright (c) 2026 GS Fleet
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include <zephyr/drivers/modem/modem_cellular.h>
+
+#define DT_DRV_COMPAT quectel_eg800z
+
+MODEM_CELLULAR_COMMON_CHAT_MATCHES();
+MODEM_CHAT_MATCH_DEFINE(quectel_eg800z_powered_down_match, "POWERED DOWN", "", NULL);
+
+MODEM_CHAT_MATCHES_DEFINE(quectel_eg800z_unsol, MODEM_CELLULAR_COMMON_UNSOL_MATCHES);
+
+MODEM_CHAT_SCRIPT_CMDS_DEFINE(
+	quectel_eg800z_init_chat_script_cmds, MODEM_CHAT_SCRIPT_CMD_RESP("AT", ok_match),
+	MODEM_CHAT_SCRIPT_CMD_RESP("ATE0", ok_match),
+	/* RTS/CTS are wired on this carrier board - enable RTS/CTS hardware
+	 * flow control (Quectel's standard AT+IFC convention: 2 = hardware,
+	 * matching this driver's uart-flow-control setting) rather than rely
+	 * on whatever the module's power-on default happens to be. */
+	MODEM_CHAT_SCRIPT_CMD_RESP("AT+IFC=2,2", ok_match),
+	MODEM_CHAT_SCRIPT_CMD_RESP("AT+CFUN?", ok_match),
+	MODEM_CHAT_SCRIPT_CMD_RESP("AT+CFUN=4", ok_match),
+	MODEM_CHAT_SCRIPT_CMD_RESP("AT+CMEE=1", ok_match),
+	MODEM_CHAT_SCRIPT_CMD_RESP("AT+CEREG=1", ok_match),
+	MODEM_CHAT_SCRIPT_CMD_RESP("AT+CEREG?", ok_match),
+	MODEM_CHAT_SCRIPT_CMD_RESP("AT+CGSN", imei_match), MODEM_CHAT_SCRIPT_CMD_RESP("", ok_match),
+	MODEM_CHAT_SCRIPT_CMD_RESP("AT+CGMM", cgmm_match), MODEM_CHAT_SCRIPT_CMD_RESP("", ok_match),
+	MODEM_CHAT_SCRIPT_CMD_RESP("AT+CGMI", cgmi_match), MODEM_CHAT_SCRIPT_CMD_RESP("", ok_match),
+	MODEM_CHAT_SCRIPT_CMD_RESP("AT+CGMR", cgmr_match), MODEM_CHAT_SCRIPT_CMD_RESP("", ok_match),
+	MODEM_CHAT_SCRIPT_CMD_RESP("AT+CIMI", cimi_match), MODEM_CHAT_SCRIPT_CMD_RESP("", ok_match),
+	/* Enables MAIN_DTR-gated sleep (Quectel Low Power Mode Application
+	 * Note for this module family): once enabled, the module is free to
+	 * enter its low-power state whenever DTR is allowed high and it is
+	 * otherwise idle. Zephyr's UART backend already drives mdm-dtr-gpios
+	 * low around every pipe open/active period and releases it (high,
+	 * given GPIO_ACTIVE_LOW in the devicetree matching this module's DTR
+	 * polarity) when idle - this command is what makes the module
+	 * actually act on that instead of ignoring DTR. */
+	MODEM_CHAT_SCRIPT_CMD_RESP("AT+QSCLK=1", ok_match),
+	MODEM_CHAT_SCRIPT_CMD_RESP("AT+CMUX=0,0,5,127", ok_match));
+
+MODEM_CHAT_SCRIPT_DEFINE(quectel_eg800z_init_chat_script, quectel_eg800z_init_chat_script_cmds,
+			 abort_matches, modem_cellular_chat_callback_handler, 30);
+
+MODEM_CHAT_SCRIPT_CMDS_DEFINE(quectel_eg800z_dial_chat_script_cmds,
+			      MODEM_CHAT_SCRIPT_CMD_RESP_MULT("AT+CGACT=0,1", allow_match),
+			      MODEM_CHAT_SCRIPT_CMD_RESP("AT+CFUN=1", ok_match),
+			      /* Small delay before dialing, otherwise some
+			       * modules answer 'NO CARRIER' and abort. */
+			      MODEM_CHAT_SCRIPT_CMD_RESP_NONE("AT", 500),
+			      MODEM_CHAT_SCRIPT_CMD_RESP("ATD*99***1#", connect_match));
+
+MODEM_CHAT_SCRIPT_DEFINE(quectel_eg800z_dial_chat_script, quectel_eg800z_dial_chat_script_cmds,
+			 dial_abort_matches, modem_cellular_chat_callback_handler, 10);
+
+MODEM_CHAT_SCRIPT_CMDS_DEFINE(quectel_eg800z_periodic_chat_script_cmds,
+			      MODEM_CHAT_SCRIPT_CMD_RESP("AT+CEREG?", ok_match),
+			      MODEM_CHAT_SCRIPT_CMD_RESP("AT+CSQ", csq_match));
+
+MODEM_CHAT_SCRIPT_DEFINE(quectel_eg800z_periodic_chat_script,
+			 quectel_eg800z_periodic_chat_script_cmds, abort_matches,
+			 modem_cellular_chat_callback_handler, 4);
+
+/* AT+QPOWD=1: OK immediately, then the module deregisters and outputs the
+ * "POWERED DOWN" URC once shutdown has actually completed - Quectel's AT
+ * command manual documents up to 60s for the deregistration step. Falls
+ * back to the PWRKEY GPIO pulse (power_pulse_duration_ms below) if this
+ * script doesn't complete within its own timeout. */
+MODEM_CHAT_SCRIPT_CMDS_DEFINE(quectel_eg800z_shutdown_chat_script_cmds,
+			      MODEM_CHAT_SCRIPT_CMD_RESP("AT+QPOWD=1", ok_match),
+			      MODEM_CHAT_SCRIPT_CMD_RESP("", quectel_eg800z_powered_down_match));
+
+MODEM_CHAT_SCRIPT_DEFINE(quectel_eg800z_shutdown_chat_script,
+			 quectel_eg800z_shutdown_chat_script_cmds, abort_matches,
+			 modem_cellular_chat_callback_handler, 60);
+
+static const struct modem_cellular_vendor_config quectel_eg800z_vendor = {
+	/* clang-format off */
+	.scripts = {
+		.init = &quectel_eg800z_init_chat_script,
+		.dial = &quectel_eg800z_dial_chat_script,
+		.periodic = &quectel_eg800z_periodic_chat_script,
+		.shutdown = &quectel_eg800z_shutdown_chat_script,
+	},
+	.unsol_matches = {
+		.matches = quectel_eg800z_unsol,
+		.size = ARRAY_SIZE(quectel_eg800z_unsol),
+	},
+	/* clang-format on */
+	/* PWRKEY is active-low on the same pin for both directions: EG800Z
+	 * hardware design documents >=500ms to power on and >=650ms to power
+	 * off. The framework only supports one pulse duration for both, so
+	 * this uses the larger value - a longer-than-minimum power-on pulse
+	 * is harmless. */
+	.power_pulse_duration_ms = 650,
+	/* RESET_N is active-low, >=300ms per the hardware design guide -
+	 * documented as a last-resort recovery path, not part of normal
+	 * power-on/off sequencing. */
+	.reset_pulse_duration_ms = 300,
+	/* The EG800Z and sibling EG800AK turn-on timing diagrams disagree on
+	 * exact PWRKEY-release -> UART-ready time (~10s vs ~17s) - this is a
+	 * starting point to tune against real hardware, not a spec value. */
+	.startup_time_ms = 20000,
+	/* EG800AK's power-down procedure figure documents 2-10s from PWRKEY
+	 * release to OFF confirmed. The AT+QPOWD script above has its own,
+	 * much longer 60s timeout for the software shutdown path. */
+	.shutdown_time_ms = 10000,
+};
+
+/* 2026-10-07 upstream pin advance (sdk-nrf main -> 2026-10-07):
+ * MODEM_DT_INST_PPP_DEFINE dropped its separate RX/TX buffer-size params for
+ * a single shared _buf_size. Kept the larger of the old RX=1500/TX=64 split
+ * (see cellular_fibocom_le270.c's identical fix for the full reasoning);
+ * mtu=98 unchanged. This instance currently has no devicetree node enabling
+ * it in this project (superseded by modemEg800zPpp.cpp's custom transport
+ * once AT+CMUX was found unsupported on this modem - see patches.yml), so
+ * this is an arity fix only, not a hardware-verified behavior change. */
+#define MODEM_CELLULAR_DEVICE_QUECTEL_EG800Z(inst)                                                 \
+	MODEM_DT_INST_PPP_DEFINE(inst, MODEM_CELLULAR_INST_NAME(ppp, inst), NULL, 98, 1500);       \
+                                                                                                   \
+	static struct modem_cellular_data MODEM_CELLULAR_INST_NAME(data, inst) = {                 \
+		.chat_delimiter = "\r",                                                            \
+		.chat_filter = "\n",                                                               \
+		.ppp = &MODEM_CELLULAR_INST_NAME(ppp, inst),                                       \
+	};                                                                                         \
+                                                                                                   \
+	MODEM_CELLULAR_DEFINE_AND_INIT_USER_PIPES(inst, (user_pipe_0, 3), (user_pipe_1, 4))        \
+                                                                                                   \
+	MODEM_CELLULAR_DEFINE_INSTANCE(inst, &quectel_eg800z_vendor)
+
+DT_INST_FOREACH_STATUS_OKAY(MODEM_CELLULAR_DEVICE_QUECTEL_EG800Z)
