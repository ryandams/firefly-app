index 00000000000..1f34a320226
--- /dev/null
+++ b/drivers/modem/vendor_modem_cellular/cellular_fibocom_le270.c
@@ -0,0 +1,316 @@
+/*
+ * Copyright (c) 2026 GS Fleet
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include <zephyr/drivers/modem/modem_cellular.h>
+
+#define DT_DRV_COMPAT fibocom_le270
+
+MODEM_CELLULAR_COMMON_CHAT_MATCHES();
+
+MODEM_CHAT_MATCHES_DEFINE(fibocom_le270_unsol, MODEM_CELLULAR_COMMON_UNSOL_MATCHES);
+
+MODEM_CHAT_SCRIPT_CMDS_DEFINE(
+	fibocom_le270_init_chat_script_cmds, MODEM_CHAT_SCRIPT_CMD_RESP("AT", ok_match),
+	MODEM_CHAT_SCRIPT_CMD_RESP("ATE0", ok_match),
+	/* AT+CFUN=4 deliberately NOT sent (removed 2026-10-05, was here since the
+	 * first working revision of this script). Joulescope + log correlation
+	 * (Modem_comparison_nRF93M1_vs_LE270.docx, section 6) showed this module
+	 * powers up in CFUN=1 and starts attaching to the network on its own
+	 * about 1.6s after PWRKEY drops - well before this init script even
+	 * starts (it runs on a fixed post-boot timer, see startup_time_ms
+	 * below). Forcing CFUN=4 here cancelled that in-progress attach
+	 * (~40mC wasted, measured), and the dial script then had to attach a
+	 * SECOND time after forcing CFUN=1 back. Simply never leaving CFUN=1
+	 * lets the one-and-only attach finish in the background while CMUX/APN
+	 * are being set up, instead of paying for two. AT+CFUN? below is kept
+	 * as a read-only diagnostic (confirms we're in CFUN=1 as expected). */
+	MODEM_CHAT_SCRIPT_CMD_RESP("AT+CFUN?", ok_match),
+	/* AT+CMEE deliberately NOT set anywhere in this driver (stays at the
+	 * module's own default, CMEE=0 - plain "ERROR" on failure, no
+	 * "+CME ERROR: <reason>" wrapper). This isn't an oversight: every
+	 * match table modem_cellular's generic framework uses here
+	 * (abort_matches, allow_match, dial_abort_matches) only recognizes a
+	 * bare "ERROR" line - none of them match the "+CME ERROR: ..." prefix
+	 * CMEE=1/2 switches failures to. Tried CMEE=2 for better diagnostics
+	 * during LE270 bring-up and it broke exactly that: AT+CGACT=0,1 in
+	 * the dial script below answering "+CME ERROR: ue busy" went
+	 * unrecognized by allow_match, so the step never advanced and the
+	 * whole dial script sat until its own 90s timeout instead of moving
+	 * on the way allow_match is supposed to let it. If verbose error text
+	 * is needed again for debugging, capture it with the `modem at`
+	 * shell command instead of changing this script's error reporting
+	 * mode (see conf/modem_le270.conf / CONFIG_MODEM_AT_SHELL). */
+	/* AT+CEREG=1 (unsolicited registration URCs) deliberately NOT sent:
+	 * real hardware shows this module broadcasts every +CEREG: URC
+	 * identically on ALL THREE open CMUX DLCIs at once (confirmed in raw
+	 * frame captures - the same bytes arrive on ch:1, ch:2, AND ch:3
+	 * within the same few milliseconds), not just the one DLCI the AT
+	 * session is attached to. Right as modem_cellular hands DLCI2 over
+	 * to PPP after a successful dial (RUN_DIAL_SCRIPT's SCRIPT_SUCCESS
+	 * handler), this flood of duplicated URCs races the handover: if a
+	 * stale "searching" (+CEREG: 2) sample gets parsed by
+	 * modem_cellular_chat_on_cxreg() after a "registered" (+CEREG: 5)
+	 * one purely due to the duplication, modem_cellular_is_registered()
+	 * flips to false, MODEM_CELLULAR_EVENT_DEREGISTERED fires, and -
+	 * since this driver has no separate .network script - the state
+	 * machine goes AWAIT_PPP_DEAD -> (after reset_pulse_duration_ms,
+	 * 200ms - matches the real-hardware timing exactly) -> back to
+	 * RUN_DIAL_SCRIPT, reattaching the AT chat parser to DLCI2 while
+	 * PPP is still actively using it for data. From there PPP's own LCP
+	 * retransmissions get fed into modem_chat as garbage ("receive
+	 * buffer overrun", repeating) until the dial script times out,
+	 * retries, and eventually srvNetwork's own 120s timeout ends the
+	 * round - observed end-to-end on real hardware.
+	 *
+	 * Leaving CEREG at the module's own default (0, unsolicited
+	 * reporting off) avoids the duplicated-URC race entirely.
+	 * Registration tracking still works: modem_cellular's periodic
+	 * script (fibocom_le270_periodic_chat_script below, every
+	 * CONFIG_MODEM_CELLULAR_PERIODIC_SCRIPT_MS = 2000ms once in
+	 * AWAIT_REGISTERED/REGISTERED) polls AT+CEREG? directly, and a
+	 * queried response - unlike an unsolicited URC - only ever comes
+	 * back on the one channel that asked, so it doesn't suffer this
+	 * duplication. The only cost is detecting a registration change
+	 * within ~2s instead of instantly. */
+	MODEM_CHAT_SCRIPT_CMD_RESP("AT+CEREG?", ok_match),
+	MODEM_CHAT_SCRIPT_CMD_RESP("AT+CGSN", imei_match), MODEM_CHAT_SCRIPT_CMD_RESP("", ok_match),
+	MODEM_CHAT_SCRIPT_CMD_RESP("AT+CGMM", cgmm_match), MODEM_CHAT_SCRIPT_CMD_RESP("", ok_match),
+	MODEM_CHAT_SCRIPT_CMD_RESP("AT+CGMI", cgmi_match), MODEM_CHAT_SCRIPT_CMD_RESP("", ok_match),
+	/* AT+CGMR: also doubles as this driver's firmware-version breadcrumb -
+	 * cgmr_match feeds CELLULAR_MODEM_INFO_FW_VERSION, which
+	 * srvNetwork.cpp logs on every connect() ("modem firmware version:
+	 * ..."). Useful for telling hardware apart after a vendor firmware
+	 * update, as happened here (see the CMUX history below). */
+	MODEM_CHAT_SCRIPT_CMD_RESP("AT+CGMR", cgmr_match), MODEM_CHAT_SCRIPT_CMD_RESP("", ok_match),
+	/* AT+CIMI removed: manual sec 3.10 (p.29) marks it the only one of
+	 * the five identity commands requiring RequireSIMCardNormal=Yes, and
+	 * documents its failure as a plain "ERROR" - the same zero-tolerance
+	 * abort_matches hit AT+CMEE=1 caused above, if the SIM isn't fully
+	 * ready yet (this script has no AT+CPIN? gate). Nothing reads
+	 * CELLULAR_MODEM_INFO_SIM_IMSI today, so dropping it costs nothing. */
+	/* Fibocom LE Series AT Commands User Manual V1.6 section 4.16: up to
+	 * 3 channels of CMUX multiplexing, basic mode, UIH frames only,
+	 * 115200 bps (port_speed=5, matching this UART's current speed), N1=127
+	 * to match Kconfig.cellular's MODEM_CMUX_DEFAULT_MTU_127 for this
+	 * driver.
+	 *
+	 * History: this exact command (and AT+CMUX=? alone, and AT+CMEE=1,
+	 * AT+CMEE=2, AT+CIMI - five documented-valid commands in total) all
+	 * failed with a fast, clean ERROR on this module's original firmware
+	 * (12007.7000.00.04.37.03), on every CFUN state tried, the same
+	 * "command doesn't actually exist on this firmware" signature
+	 * eventually confirmed for the sibling cellular_quectel_eg800z.c. A
+	 * Fibocom FAE provided updated firmware after being shown this
+	 * evidence, and AT+CMUX (full 4-parameter form, this exact line)
+	 * started working immediately: CMUX connects, DLCI1/2/3 all open,
+	 * AT+CGDCONT succeeds. Kept here, in this form, as the known-good
+	 * command for that firmware - if a module ever reports the older
+	 * firmware version again (see the AT+CGMR comment above), expect
+	 * this exact step to abort the script again. */
+	MODEM_CHAT_SCRIPT_CMD_RESP("AT+CMUX=0,0,5,127", ok_match));
+
+MODEM_CHAT_SCRIPT_DEFINE(fibocom_le270_init_chat_script, fibocom_le270_init_chat_script_cmds,
+			 abort_matches, modem_cellular_chat_callback_handler, 30);
+
+MODEM_CHAT_SCRIPT_CMDS_DEFINE(fibocom_le270_dial_chat_script_cmds,
+			      /* allow_match, not ok_match, on purpose: on this
+			       * network AT+CGACT=0,1 (best-effort "deactivate
+			       * context 1 before dialing, in case it's in a
+			       * stale state") reliably answers ERROR - observed
+			       * both "ue busy" and "Last PDN disconnection not
+			       * allowed" on real hardware - never OK. allow_match
+			       * treats that as expected and moves straight on;
+			       * this only misbehaves if CMEE is ever turned on
+			       * elsewhere (see the AT+CMEE note in the init
+			       * script above for why). */
+			      MODEM_CHAT_SCRIPT_CMD_RESP_MULT("AT+CGACT=0,1", allow_match),
+			      /* AT+CFUN=1 and the fixed 500ms "AT" settle that used
+			       * to sit here are both gone (removed 2026-10-05,
+			       * together with the init script's AT+CFUN=4 above):
+			       * since we never leave CFUN=1, there's no mode
+			       * switch left to settle after. Replaced with a real
+			       * AT+CEREG? read instead of a dead timer - this
+			       * does double duty: (1) it's the modem_comparison
+			       * report's suggested "CEREG check" in place of the
+			       * blind wait before ATD, and (2) critically, it
+			       * refreshes modem_cellular_is_registered()'s cached
+			       * registration_status right before CONNECT, instead
+			       * of leaving it stale from the init script's own
+			       * early AT+CEREG? (sent before CMUX/APN, likely
+			       * before the attach above has finished). That cache
+			       * is exactly what modem_cellular_on_await_registered
+			       * _state_enter() checks immediately on entry after a
+			       * successful dial - if it's already true, REGISTERED
+			       * is entered synchronously and net_if_dormant_off()
+			       * runs right away; if this query is the only thing
+			       * that ever updated it (the old CFUN=4 flow left it
+			       * NOT_REGISTERED at this exact point every time),
+			       * the driver otherwise has to sit idle for one full
+			       * CONFIG_MODEM_CELLULAR_PERIODIC_SCRIPT_MS (2000ms)
+			       * before the periodic script's own CEREG? read
+			       * updates it - confirmed as the exact source of the
+			       * report's "PPP starts exactly 2.000s after CONNECT"
+			       * finding by reading modem_cellular.c's state
+			       * machine (on_run_dial_script_state_enter attaches
+			       * PPP and fires net_if_carrier_on() immediately on
+			       * CONNECT regardless of registration, but the net_if
+			       * stays dormant - no LCP/IPCP traffic - until
+			       * REGISTERED's net_if_dormant_off() runs). If this
+			       * query still reads "not yet registered" (e.g. a
+			       * slow cell search, as in test 1 of that report),
+			       * this changes nothing: falls through to the same
+			       * periodic-script wait as before. */
+			      MODEM_CHAT_SCRIPT_CMD_RESP("AT+CEREG?", ok_match),
+			      /* AT Commands User Manual V1.6 section 11.3
+			       * (D*99) documents ATD*99# as the plain form;
+			       * *99***1# additionally selects PDP context 1
+			       * (<cid>), matching AT+CGDCONT's default cid
+			       * that MODEM_CELLULAR configures. */
+			      MODEM_CHAT_SCRIPT_CMD_RESP("ATD*99***1#", connect_match));
+
+/* Timeout raised from the eg800q template's 10s: modem_chat_script_start()
+ * schedules this as a single whole-script watchdog (never reset per step),
+ * and the manual's own documented MaxResponseDuration for this script's
+ * steps already sums past 10s on paper (AT+CGACT 50000ms + AT+CEREG?
+ * 5000ms + ATD*99***1# 3000ms = 58s worst case) - the same "whole script
+ * dies, CMUX/PPP never starts" failure as the AT+CMEE=1 abort, just via
+ * TIMEOUT instead of ABORT. 90s covers the documented worst case with
+ * margin; real steps run in milliseconds. */
+MODEM_CHAT_SCRIPT_DEFINE(fibocom_le270_dial_chat_script, fibocom_le270_dial_chat_script_cmds,
+			 dial_abort_matches, modem_cellular_chat_callback_handler, 90);
+
+MODEM_CHAT_SCRIPT_CMDS_DEFINE(fibocom_le270_periodic_chat_script_cmds,
+			      MODEM_CHAT_SCRIPT_CMD_RESP("AT+CEREG?", ok_match),
+			      MODEM_CHAT_SCRIPT_CMD_RESP("AT+CSQ", csq_match));
+
+/* Timeout raised from the eg800q template's 4s (same single whole-script
+ * watchdog as the dial script above): the manual documents
+ * MaxResponseDuration=5000ms for both AT+CEREG? and AT+CSQ, 10s combined
+ * worst case, already exceeding the old 4s budget on paper. */
+MODEM_CHAT_SCRIPT_DEFINE(fibocom_le270_periodic_chat_script,
+			 fibocom_le270_periodic_chat_script_cmds, abort_matches,
+			 modem_cellular_chat_callback_handler, 15);
+
+/* Added 2026-10-05, replacing "no .shutdown script" (see the removed comment
+ * this replaced, preserved in git history). Modem_comparison_nRF93M1_vs_
+ * LE270.docx section 6 measured the modem staying active for ~2.6-2.7s after
+ * CMUX/PPP teardown with NO shutdown script configured - an uncommanded,
+ * autonomous detach the modem only starts once it notices its AT/PPP
+ * channels have vanished - followed by a completely separate, much larger
+ * cost: modem_cellular.c's INIT_POWER_OFF, with no .shutdown script, falls
+ * straight to modem_cellular_begin_power_off_pulse() (power_off_pulse_
+ * duration_ms, 3100ms of PWRKEY held low) then AWAIT_POWER_OFF
+ * (shutdown_time_ms, 10000ms) before declaring the modem off - 13.1s fixed,
+ * even though the Joulescope trace shows modem current already at 0 well
+ * before either of those timers even finishes. Defining .scripts.shutdown
+ * changes this: per modem_cellular_run_shutdown_script_event_handler(),
+ * SCRIPT_SUCCESS here goes directly to IDLE, skipping the power pulse AND
+ * shutdown_time_ms entirely (same codepath cellular_quectel_eg800q.c already
+ * relies on for its AT+QPOWD). AT+CPWROFF is the Hardware Guide V2.2 sec 4.2
+ * documented power-off command - a real, commanded detach+power-off instead
+ * of letting the modem notice on its own, which is exactly what the report
+ * suggested ("send the power-off command on the AT DLCI"). It returns a bare
+ * OK with no completion URC (same doc, same section), so unlike EG800Z's
+ * "POWERED DOWN" match this can't confirm the modem has actually finished
+ * powering down - the trailing delay below exists for that reason, sized off
+ * the one real data point available (the ~2.6-2.7s uncommanded-detach
+ * window), not a documented completion time. If AT+CPWROFF ever errors
+ * (abort_matches), modem_cellular_run_shutdown_script_event_handler's
+ * SCRIPT_FAILED path already falls back to modem_cellular_begin_power_off_
+ * pulse() automatically - no worse off than before this script existed.
+ * Flagged for hardware verification: confirm on the Joulescope trace that
+ * modem current is actually 0 by the time this script's delay elapses, and
+ * tune the 3000ms figure from there. */
+MODEM_CHAT_SCRIPT_CMDS_DEFINE(fibocom_le270_shutdown_chat_script_cmds,
+			      MODEM_CHAT_SCRIPT_CMD_RESP("AT+CPWROFF", ok_match),
+			      MODEM_CHAT_SCRIPT_CMD_RESP_NONE("", 3000));
+
+MODEM_CHAT_SCRIPT_DEFINE(fibocom_le270_shutdown_chat_script,
+			 fibocom_le270_shutdown_chat_script_cmds, abort_matches,
+			 modem_cellular_chat_callback_handler, 15);
+
+static const struct modem_cellular_vendor_config fibocom_le270_vendor = {
+	/* clang-format off */
+	.scripts = {
+		.init = &fibocom_le270_init_chat_script,
+		.dial = &fibocom_le270_dial_chat_script,
+		.periodic = &fibocom_le270_periodic_chat_script,
+		.shutdown = &fibocom_le270_shutdown_chat_script,
+	},
+	.unsol_matches = {
+		.matches = fibocom_le270_unsol,
+		.size = ARRAY_SIZE(fibocom_le270_unsol),
+	},
+	/* clang-format on */
+	/* Hardware Guide V2.2 section 4.2: power on needs PWRKEY pulled low
+	 * for >=650ms; hardware power off needs >=3.1s (3100ms) - too far
+	 * apart to share one duration without either a wastefully long
+	 * power-on pulse or a too-short power-off one. This pulse path is now
+	 * the fallback only (see .shutdown above) - still kept at the full
+	 * documented 3100ms, since it's the hard guarantee that cuts power
+	 * even if AT+CPWROFF ever stops responding. modem_cellular.h grew
+	 * a separate power_off_pulse_duration_ms field for exactly this split
+	 * (falls back to power_pulse_duration_ms when left at 0, so every
+	 * other vendor driver is unaffected) - see
+	 * zephyr/patches/zephyr/fibocom-le270-driver.patch. 700ms keeps
+	 * ~50ms margin above the documented 650ms power-on minimum without
+	 * needlessly extending how long the UART pipe stays unattached (see
+	 * the AWAIT_POWER_ON note on startup_time_ms below - the modem starts
+	 * transmitting almost immediately after PWRKEY drops, so a shorter
+	 * pulse means less of its early output is missed). */
+	.power_pulse_duration_ms = 700,
+	.power_off_pulse_duration_ms = 3100,
+	/* RESET_N held low for >=100ms per section 4.3; doubled for margin. */
+	.reset_pulse_duration_ms = 200,
+	/* Not documented in the Hardware Guide (only the PWRKEY-pulse timing
+	 * diagrams are). Was 15000ms as an untested placeholder ("a starting
+	 * point to tune against real hardware", following the EG800Z entry's
+	 * own undocumented-startup margin) - this IS that tuning, now backed
+	 * by data: the real hardware log shows the very first "AT" sent once
+	 * RUN_INIT_SCRIPT begins already gets a clean OK back in ~4.5ms, so
+	 * the modem's AT interface is up well before a 15s wait completes.
+	 * Dropped to 2000ms, then tuned again 2026-10-05 with three more
+	 * hardware samples (Modem_comparison_nRF93M1_vs_LE270.docx): all three
+	 * independently show "AT command ready" at 1.06s and "+SIM READY" at
+	 * 1.43s (power_pulse_duration_ms=700ms already included in both), with
+	 * the init script itself only ever starting at the fixed 2.70s mark
+	 * (700 + 2000) - over a second later than it needs to. Dropped to
+	 * 1200ms (700 + 1200 = 1.9s total), leaving ~470ms margin over the
+	 * worst "+SIM READY" sample across all three boots rather than the
+	 * single sample the 2000ms figure above was based on. Flagged for
+	 * hardware verification like the figure it replaces. */
+	.startup_time_ms = 1200,
+	/* Fallback-path-only since .shutdown above was added 2026-10-05: only
+	 * reached if AT+CPWROFF errors and modem_cellular falls back to the
+	 * power_off_pulse_duration_ms pulse. Was 10000ms, sized before any
+	 * hardware data existed; the same Joulescope traces that justified
+	 * .shutdown above show modem current reaching 0 well within the
+	 * power_off_pulse_duration_ms pulse itself, so this fallback-only
+	 * value no longer needs to carry the whole safety margin alone.
+	 * Dropped to 2000ms - still generous for a path that should now be
+	 * rare, without reintroducing a double-digit-second wait if it is
+	 * ever hit. */
+	.shutdown_time_ms = 2000,
+};
+
+/* One user pipe only, on DLCI 3: the AT Commands User Manual documents "up
+ * to 3 channels of CMUX multiplexing" for this series, one fewer than the
+ * 2-user-pipe template cellular_quectel_eg800q.c/eg800z.c use - stay inside
+ * that documented limit rather than assume it also covers a 4th DLCI. */
+#define MODEM_CELLULAR_DEVICE_FIBOCOM_LE270(inst)                                                 \
+	MODEM_DT_INST_PPP_DEFINE(inst, MODEM_CELLULAR_INST_NAME(ppp, inst), NULL, 98, 1500, 64);  \
+                                                                                                   \
+	static struct modem_cellular_data MODEM_CELLULAR_INST_NAME(data, inst) = {                \
+		.chat_delimiter = "\r",                                                           \
+		.chat_filter = "\n",                                                              \
+		.ppp = &MODEM_CELLULAR_INST_NAME(ppp, inst),                                      \
+	};                                                                                        \
+                                                                                                   \
+	MODEM_CELLULAR_DEFINE_AND_INIT_USER_PIPES(inst, (user_pipe_0, 3))                          \
+                                                                                                   \
+	MODEM_CELLULAR_DEFINE_INSTANCE(inst, &fibocom_le270_vendor)
+
+DT_INST_FOREACH_STATUS_OKAY(MODEM_CELLULAR_DEVICE_FIBOCOM_LE270)
