diff --git a/drivers/modem/vendor_modem_cellular/cellular_fibocom_le270.c b/drivers/modem/vendor_modem_cellular/cellular_fibocom_le270.c
new file mode 100644
index 00000000000..a6499484c90
--- /dev/null
+++ b/drivers/modem/vendor_modem_cellular/cellular_fibocom_le270.c
@@ -0,0 +1,237 @@
+/*
+ * Copyright (c) 2026 GS Fleet
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include <zephyr/drivers/modem/modem_cellular.h>
+
+#define DT_DRV_COMPAT fibocom_le270
+
+MODEM_CELLULAR_COMMON_CHAT_MATCHES();
+
+MODEM_CHAT_MATCHES_DEFINE(fibocom_le270_unsol, MODEM_CELLULAR_COMMON_UNSOL_MATCHES);
+
+MODEM_CHAT_SCRIPT_CMDS_DEFINE(
+	fibocom_le270_init_chat_script_cmds, MODEM_CHAT_SCRIPT_CMD_RESP("AT", ok_match),
+	MODEM_CHAT_SCRIPT_CMD_RESP("ATE0", ok_match),
+	/* AT+CMEE=2: "detailed" (string) +CME ERROR values instead of bare
+	 * ERROR, per AT Commands User Manual V1.6 sec 13.1.1 - so any command
+	 * that fails from here on (AT+CMUX below, in particular) hopefully
+	 * reports *why* instead of a bare ERROR. Non-fatal on purpose
+	 * (allow_match: OK or ERROR both continue the script) rather than
+	 * ok_match: AT+CMEE=1 was literally the command this driver's own
+	 * history shows aborting the whole init script on real hardware (see
+	 * the removed-command note further down) - if AT+CMEE=2 hits the same
+	 * fate, losing verbose errors is a fine trade for not losing the rest
+	 * of init again. */
+	MODEM_CHAT_SCRIPT_CMD_RESP_MULT("AT+CMEE=2", allow_match),
+	MODEM_CHAT_SCRIPT_CMD_RESP("AT+CFUN?", ok_match),
+	/* AT+CFUN=4 ("flight mode" per AT Commands User Manual V1.6 sec 4.13 -
+	 * CFUN=0, not CFUN=4, is "minimum functionality") used to be forced
+	 * here to keep the radio off during the identity queries below. Two
+	 * things argued for removing it as an experiment rather than a
+	 * two-line settle-delay patch over it:
+	 *  1. It was never free: real hardware measured it at 203ms to return
+	 *     OK, vs ~6ms for the AT+CFUN? read just above, and the very next
+	 *     command sent right after (AT+CMEE=1, since removed) got a plain
+	 *     ERROR in ~5ms - a real state-transition cost, not a no-op.
+	 *  2. AT+CFUN? above already shows this module boots in CFUN=1 (full
+	 *     functionality) on its own, by default - we were the ones
+	 *     forcing a transition away from that, at the one real cost measured
+	 *     in (1), to save a modest amount of RF power during a
+	 *     fairly short init sequence.
+	 * This is also a live experiment: AT+CMUX has since failed with a
+	 * clean ERROR in every form tried (4-param, 3-param, the bare
+	 * capability query) while always issued from CFUN=4 - never yet tried
+	 * from this module's own default CFUN=1. The manual's own
+	 * characteristics table for +CMUX says no functionality-mode
+	 * prerequisite exists, but this exact firmware has already disagreed
+	 * with its own manual more than once (AT+CMEE=1, AT+CIMI), so this is
+	 * worth ruling in or out on real hardware rather than from
+	 * documentation alone. If AT+CMUX still fails with CFUN=4 gone, that
+	 * rules CFUN state out entirely as a contributing factor; if it
+	 * succeeds, CFUN=4 was the whole story and the radio simply needs to
+	 * stay enabled through init (losing the power saving CFUN=4 offered
+	 * is the trade-off worth confirming before accepting it back). */
+	MODEM_CHAT_SCRIPT_CMD_RESP("AT+CEREG=1", ok_match),
+	MODEM_CHAT_SCRIPT_CMD_RESP("AT+CEREG?", ok_match),
+	MODEM_CHAT_SCRIPT_CMD_RESP("AT+CGSN", imei_match), MODEM_CHAT_SCRIPT_CMD_RESP("", ok_match),
+	MODEM_CHAT_SCRIPT_CMD_RESP("AT+CGMM", cgmm_match), MODEM_CHAT_SCRIPT_CMD_RESP("", ok_match),
+	MODEM_CHAT_SCRIPT_CMD_RESP("AT+CGMI", cgmi_match), MODEM_CHAT_SCRIPT_CMD_RESP("", ok_match),
+	MODEM_CHAT_SCRIPT_CMD_RESP("AT+CGMR", cgmr_match), MODEM_CHAT_SCRIPT_CMD_RESP("", ok_match),
+	/* AT+CIMI removed: manual sec 3.10 (p.29) marks it the only one of
+	 * the five identity commands requiring RequireSIMCardNormal=Yes, and
+	 * documents its failure as a plain "ERROR" - the same zero-tolerance
+	 * abort_matches hit AT+CMEE=1 caused above, if the SIM isn't fully
+	 * ready yet (this script has no AT+CPIN? gate). Nothing reads
+	 * CELLULAR_MODEM_INFO_SIM_IMSI today, so dropping it costs nothing. */
+	/* Fibocom LE Series AT Commands User Manual V1.6 section 4.16: up to
+	 * 3 channels of CMUX multiplexing, basic mode, UIH frames only,
+	 * 115200 bps (port_speed=5), matching this UART's current speed.
+	 *
+	 * The original 4-parameter form "AT+CMUX=0,0,5,127" (port_speed=5
+	 * plus N1=127 sized to Kconfig.cellular's MODEM_CMUX_DEFAULT_MTU_127
+	 * for this driver) hit a real-hardware abort: a fast (~5.4ms), clean
+	 * ERROR - the same immediate, well-formed-rejection signature as the
+	 * AT+CMEE=1/AT+CIMI aborts already removed above, not a timeout or
+	 * garbled response. Every individual parameter was already confirmed
+	 * in-range against this manual's own "AT+CMUX=? ->
+	 * (0),(0),(1-8),(1-1509),..." query response, so this isn't an
+	 * out-of-range value. Re-reading section 4.16 (pp.53-56) itself: its
+	 * Description states "if the parameters are left out, the default
+	 * value is used", and the section's only worked SET example is the
+	 * 3-parameter "AT+CMUX=0,0,1 -> OK" (mode, subset, port_speed only) -
+	 * a 4-parameter invocation is never actually demonstrated. Dropped N1
+	 * here to match the manual's only proven-working shape; port_speed=5
+	 * is kept (the manual's own example uses port_speed=1/9600, which
+	 * would silently downgrade this UART's baud rate - not wanted). N1
+	 * then defaults to 31 per the manual's READ example ("AT+CMUX? ->
+	 * +CMUX: 0,0,5,31,10,3,30,10,2"): this only shrinks the on-the-wire
+	 * CMUX frame size the modem uses, it does not change
+	 * MODEM_CMUX_DEFAULT_MTU_127, which sizes Zephyr's own local CMUX
+	 * buffers independently - a modem using smaller-than-buffer frames is
+	 * safe, just less efficient than the originally-intended 127-byte
+	 * frames.
+	 *
+	 * Diagnostic only, not a fix: the sibling cellular_quectel_eg800z.c
+	 * driver hit this exact same fast-clean-ERROR signature on the exact
+	 * same command, and its real root cause turned out to be "AT+CMUX
+	 * does not exist on this firmware at all" (absent from that module's
+	 * manual entirely) - not a parameter problem. The LE270's manual DOES
+	 * fully document AT+CMUX (mode/subset/port_speed/N1 table, a read
+	 * form, and a query form), unlike the EG800Z, so that worst case is
+	 * less likely here - but it can't be ruled out from documentation
+	 * alone, and this is a different firmware build
+	 * (12007.7000.00.04.37.03) than whatever the manual was written
+	 * against. AT+CMUX=? is always side-effect-free per the manual's own
+	 * characteristics table (no state changes, no prerequisites) and its
+	 * response - "+CMUX: (0),(0),(1-8),(1-1509),..." - lands in the DBG
+	 * log via modem_chat_on_unknown_command_received the same way the
+	 * AT+CFUN?/AT+CEREG? read commands' info lines already do. If the
+	 * next real-hardware run still ends in ERROR on the line below, this
+	 * query's response (or its own ERROR) settles which explanation is
+	 * right without another guess-and-reflash round: a normal
+	 * "+CMUX: (...)" answer here means the module claims support and the
+	 * parameter shape needs more work; an ERROR here means the EG800Z
+	 * story is repeating and this modem needs the same non-CMUX
+	 * architectural path modemEg800zPpp.cpp already uses for that one. */
+	MODEM_CHAT_SCRIPT_CMD_RESP("AT+CMUX=?", ok_match),
+	MODEM_CHAT_SCRIPT_CMD_RESP("AT+CMUX=0,0,5", ok_match));
+
+MODEM_CHAT_SCRIPT_DEFINE(fibocom_le270_init_chat_script, fibocom_le270_init_chat_script_cmds,
+			 abort_matches, modem_cellular_chat_callback_handler, 30);
+
+MODEM_CHAT_SCRIPT_CMDS_DEFINE(fibocom_le270_dial_chat_script_cmds,
+			      MODEM_CHAT_SCRIPT_CMD_RESP_MULT("AT+CGACT=0,1", allow_match),
+			      MODEM_CHAT_SCRIPT_CMD_RESP("AT+CFUN=1", ok_match),
+			      /* Small delay before dialing, otherwise some
+			       * modules answer 'NO CARRIER' and abort. */
+			      MODEM_CHAT_SCRIPT_CMD_RESP_NONE("AT", 500),
+			      /* AT Commands User Manual V1.6 section 11.3
+			       * (D*99) documents ATD*99# as the plain form;
+			       * *99***1# additionally selects PDP context 1
+			       * (<cid>), matching AT+CGDCONT's default cid
+			       * that MODEM_CELLULAR configures. */
+			      MODEM_CHAT_SCRIPT_CMD_RESP("ATD*99***1#", connect_match));
+
+/* Timeout raised from the eg800q template's 10s: modem_chat_script_start()
+ * schedules this as a single whole-script watchdog (never reset per step),
+ * and the manual's own documented MaxResponseDuration for this script's
+ * steps already sums past 10s on paper (AT+CGACT 50000ms + AT+CFUN=1
+ * 25000ms + the 500ms settle + ATD*99***1# 3000ms = ~78.5s worst case) -
+ * the same "whole script dies, CMUX/PPP never starts" failure as the
+ * AT+CMEE=1 abort, just via TIMEOUT instead of ABORT. 90s covers the
+ * documented worst case with margin; real steps run in milliseconds. */
+MODEM_CHAT_SCRIPT_DEFINE(fibocom_le270_dial_chat_script, fibocom_le270_dial_chat_script_cmds,
+			 dial_abort_matches, modem_cellular_chat_callback_handler, 90);
+
+MODEM_CHAT_SCRIPT_CMDS_DEFINE(fibocom_le270_periodic_chat_script_cmds,
+			      MODEM_CHAT_SCRIPT_CMD_RESP("AT+CEREG?", ok_match),
+			      MODEM_CHAT_SCRIPT_CMD_RESP("AT+CSQ", csq_match));
+
+/* Timeout raised from the eg800q template's 4s (same single whole-script
+ * watchdog as the dial script above): the manual documents
+ * MaxResponseDuration=5000ms for both AT+CEREG? and AT+CSQ, 10s combined
+ * worst case, already exceeding the old 4s budget on paper. */
+MODEM_CHAT_SCRIPT_DEFINE(fibocom_le270_periodic_chat_script,
+			 fibocom_le270_periodic_chat_script_cmds, abort_matches,
+			 modem_cellular_chat_callback_handler, 15);
+
+static const struct modem_cellular_vendor_config fibocom_le270_vendor = {
+	/* clang-format off */
+	.scripts = {
+		.init = &fibocom_le270_init_chat_script,
+		.dial = &fibocom_le270_dial_chat_script,
+		.periodic = &fibocom_le270_periodic_chat_script,
+		/* No .shutdown script: unlike the EG800Z (AT+QPOWD followed by
+		 * a documented "POWERED DOWN" URC), the LE270 Hardware Guide
+		 * V2.2 documents AT+CPWROFF returning a plain OK with no
+		 * completion URC, and separately documents hardware power-off
+		 * via a >=3.1s PWRKEY pulse as an equally valid method (section
+		 * 4.2). power_off_pulse_duration_ms below is sized to satisfy
+		 * that pulse directly, so RUN_SHUTDOWN_SCRIPT's power_pulse
+		 * fallback alone is sufficient - same pattern as
+		 * cellular_quectel_eg800q.c.
+		 */
+	},
+	.unsol_matches = {
+		.matches = fibocom_le270_unsol,
+		.size = ARRAY_SIZE(fibocom_le270_unsol),
+	},
+	/* clang-format on */
+	/* Hardware Guide V2.2 section 4.2: power on needs PWRKEY pulled low
+	 * for >=650ms; hardware power off needs >=3.1s (3100ms) - too far
+	 * apart to share one duration without either a wastefully long
+	 * power-on pulse or a too-short power-off one (the latter risking an
+	 * incomplete shutdown every round, since this modem has no .shutdown
+	 * script to confirm power-off any other way). modem_cellular.h grew
+	 * a separate power_off_pulse_duration_ms field for exactly this split
+	 * (falls back to power_pulse_duration_ms when left at 0, so every
+	 * other vendor driver is unaffected) - see
+	 * zephyr/patches/zephyr/fibocom-le270-driver.patch. 700ms keeps
+	 * ~50ms margin above the documented 650ms power-on minimum without
+	 * needlessly extending how long the UART pipe stays unattached (see
+	 * the AWAIT_POWER_ON note on startup_time_ms below - the modem starts
+	 * transmitting almost immediately after PWRKEY drops, so a shorter
+	 * pulse means less of its early output is missed). */
+	.power_pulse_duration_ms = 700,
+	.power_off_pulse_duration_ms = 3100,
+	/* RESET_N held low for >=100ms per section 4.3; doubled for margin. */
+	.reset_pulse_duration_ms = 200,
+	/* Not documented in the Hardware Guide (only the PWRKEY-pulse timing
+	 * diagrams are). Was 15000ms as an untested placeholder ("a starting
+	 * point to tune against real hardware", following the EG800Z entry's
+	 * own undocumented-startup margin) - this IS that tuning, now backed
+	 * by data: the real hardware log shows the very first "AT" sent once
+	 * RUN_INIT_SCRIPT begins already gets a clean OK back in ~4.5ms, so
+	 * the modem's AT interface is up well before a 15s wait completes.
+	 * Dropped to 2000ms - several orders of magnitude of margin above the
+	 * one observed sample (this is a single boot, not a characterized
+	 * worst case), and in line with cellular_sqn_gm02s.c's 2000ms for a
+	 * modem with similarly undocumented startup timing, rather than the
+	 * 10000-30000ms entries elsewhere in this file's siblings that are
+	 * sized for modems with documented multi-second boot times this
+	 * driver hasn't shown it needs. */
+	.startup_time_ms = 2000,
+	.shutdown_time_ms = 10000,
+};
+
+/* One user pipe only, on DLCI 3: the AT Commands User Manual documents "up
+ * to 3 channels of CMUX multiplexing" for this series, one fewer than the
+ * 2-user-pipe template cellular_quectel_eg800q.c/eg800z.c use - stay inside
+ * that documented limit rather than assume it also covers a 4th DLCI. */
+#define MODEM_CELLULAR_DEVICE_FIBOCOM_LE270(inst)                                                 \
+	MODEM_DT_INST_PPP_DEFINE(inst, MODEM_CELLULAR_INST_NAME(ppp, inst), NULL, 98, 1500, 64);  \
+                                                                                                   \
+	static struct modem_cellular_data MODEM_CELLULAR_INST_NAME(data, inst) = {                \
+		.chat_delimiter = "\r",                                                           \
+		.chat_filter = "\n",                                                              \
+		.ppp = &MODEM_CELLULAR_INST_NAME(ppp, inst),                                      \
+	};                                                                                        \
+                                                                                                   \
+	MODEM_CELLULAR_DEFINE_AND_INIT_USER_PIPES(inst, (user_pipe_0, 3))                          \
+                                                                                                   \
+	MODEM_CELLULAR_DEFINE_INSTANCE(inst, &fibocom_le270_vendor)
+
+DT_INST_FOREACH_STATUS_OKAY(MODEM_CELLULAR_DEVICE_FIBOCOM_LE270)

