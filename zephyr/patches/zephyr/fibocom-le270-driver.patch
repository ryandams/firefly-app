--- /dev/null
+++ b/drivers/modem/vendor_modem_cellular/cellular_fibocom_le270.c
@@ -0,0 +1,502 @@
+/*
+ * Copyright (c) 2026 GS Fleet
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include <zephyr/drivers/modem/modem_cellular.h>
+
+#define DT_DRV_COMPAT fibocom_le270
+
+MODEM_CELLULAR_COMMON_CHAT_MATCHES();
+
+/* Change 4, LE270_driver_optimisation_instructions.md: wake AWAIT_POWER_ON
+ * early on "AT command ready" instead of waiting out the full
+ * startup_time_ms fixed timer below. Reuses modem_cellular's own existing
+ * mechanism for this (modem_cellular_chat_on_modem_ready, already wired to
+ * MODEM_CELLULAR_EVENT_MODEM_READY -> modem_cellular_await_power_on_event
+ * _handler() already stops the timer and proceeds immediately on that
+ * event "as we are ready to proceed" - the same hook the shared
+ * MODEM_CELLULAR_COMMON_UNSOL_MATCHES table uses for other modems' "APP
+ * RDY"/"Ready" URCs) - no framework changes needed, just adding our own
+ * modem's URC text to this vendor driver's own match table, exactly the
+ * "vendor drivers can extend the table with their own vendor-specific
+ * URCs" pattern that macro is designed for.
+ *
+ * "AT command ready" (not "+SIM READY", the instructions document's
+ * primary suggestion) per the document's own "earlier alternative, if the
+ * init script doesn't depend on the SIM" - confirmed true here: every
+ * command in this init script was already audited for SIM dependence when
+ * AT+CIMI was removed (see that comment below), and none of
+ * AT/ATE0/AT+CEREG?/AT+CGSN/AT+CGMM/AT+CGMI/AT+CGMR/AT+CMUX require it.
+ * Exact text verified against AT Commands User Manual V1.6
+ * sec 4.14 (+MSTART, p.51-52): the module documents its own boot URCs as
+ * literally "AT command ready" and "+SIM READY" (both enabled by default,
+ * atready=1/simready=1), matching this project's own hardware logs
+ * exactly. */
+MODEM_CHAT_MATCHES_DEFINE(fibocom_le270_unsol, MODEM_CELLULAR_COMMON_UNSOL_MATCHES,
+			  MODEM_CHAT_MATCH("AT command ready", "", modem_cellular_chat_on_modem_ready));
+
+MODEM_CHAT_SCRIPT_CMDS_DEFINE(
+	fibocom_le270_init_chat_script_cmds, MODEM_CHAT_SCRIPT_CMD_RESP("AT", ok_match),
+	MODEM_CHAT_SCRIPT_CMD_RESP("ATE0", ok_match),
+	/* AT+CFUN=4 deliberately NOT sent (removed 2026-10-05, was here since the
+	 * first working revision of this script). Joulescope + log correlation
+	 * (Modem_comparison_nRF93M1_vs_LE270.docx, section 6) showed this module
+	 * powers up in CFUN=1 and starts attaching to the network on its own
+	 * about 1.6s after PWRKEY drops - well before this init script even
+	 * starts (it runs on a fixed post-boot timer, see startup_time_ms
+	 * below). Forcing CFUN=4 here cancelled that in-progress attach
+	 * (~40mC wasted, measured), and the dial script then had to attach a
+	 * SECOND time after forcing CFUN=1 back. Simply never leaving CFUN=1
+	 * lets the one-and-only attach finish in the background while CMUX/APN
+	 * are being set up, instead of paying for two.
+	 *
+	 * AT+CFUN? itself removed here too (Change 6,
+	 * LE270_driver_optimisation_instructions.md, 2026-10-06): it was only
+	 * ever a read-only diagnostic confirming CFUN=1 as expected - nothing
+	 * in this codebase reads modem_cellular_chat_on_cfun's result (there
+	 * is no such callback; this step used the bare ok_match, so the
+	 * response text itself was discarded) or acts on it. Pure dead
+	 * weight once the diagnostic job it was added for (verifying the
+	 * CFUN=4 removal above) was done. */
+	/* AT+CMEE deliberately NOT set anywhere in this driver (stays at the
+	 * module's own default, CMEE=0 - plain "ERROR" on failure, no
+	 * "+CME ERROR: <reason>" wrapper). This isn't an oversight: every
+	 * match table modem_cellular's generic framework uses here
+	 * (abort_matches, allow_match, dial_abort_matches) only recognizes a
+	 * bare "ERROR" line - none of them match the "+CME ERROR: ..." prefix
+	 * CMEE=1/2 switches failures to. Tried CMEE=2 for better diagnostics
+	 * during LE270 bring-up and it broke exactly that: AT+CGACT=0,1 in
+	 * the dial script below answering "+CME ERROR: ue busy" went
+	 * unrecognized by allow_match, so the step never advanced and the
+	 * whole dial script sat until its own 90s timeout instead of moving
+	 * on the way allow_match is supposed to let it. If verbose error text
+	 * is needed again for debugging, capture it with the `modem at`
+	 * shell command instead of changing this script's error reporting
+	 * mode (see conf/modem_le270.conf / CONFIG_MODEM_AT_SHELL). */
+	/* AT+CEREG=1 (unsolicited registration URCs) deliberately NOT sent:
+	 * real hardware shows this module broadcasts every +CEREG: URC
+	 * identically on ALL THREE open CMUX DLCIs at once (confirmed in raw
+	 * frame captures - the same bytes arrive on ch:1, ch:2, AND ch:3
+	 * within the same few milliseconds), not just the one DLCI the AT
+	 * session is attached to. Right as modem_cellular hands DLCI2 over
+	 * to PPP after a successful dial (RUN_DIAL_SCRIPT's SCRIPT_SUCCESS
+	 * handler), this flood of duplicated URCs races the handover: if a
+	 * stale "searching" (+CEREG: 2) sample gets parsed by
+	 * modem_cellular_chat_on_cxreg() after a "registered" (+CEREG: 5)
+	 * one purely due to the duplication, modem_cellular_is_registered()
+	 * flips to false, MODEM_CELLULAR_EVENT_DEREGISTERED fires, and -
+	 * since this driver has no separate .network script - the state
+	 * machine goes AWAIT_PPP_DEAD -> (after reset_pulse_duration_ms,
+	 * 200ms - matches the real-hardware timing exactly) -> back to
+	 * RUN_DIAL_SCRIPT, reattaching the AT chat parser to DLCI2 while
+	 * PPP is still actively using it for data. From there PPP's own LCP
+	 * retransmissions get fed into modem_chat as garbage ("receive
+	 * buffer overrun", repeating) until the dial script times out,
+	 * retries, and eventually srvNetwork's own 120s timeout ends the
+	 * round - observed end-to-end on real hardware.
+	 *
+	 * Leaving CEREG at the module's own default (0, unsolicited
+	 * reporting off) avoids the duplicated-URC race entirely.
+	 * Registration tracking still works: modem_cellular's periodic
+	 * script (fibocom_le270_periodic_chat_script below, every
+	 * CONFIG_MODEM_CELLULAR_PERIODIC_SCRIPT_MS = 2000ms once in
+	 * AWAIT_REGISTERED/REGISTERED) polls AT+CEREG? directly, and a
+	 * queried response - unlike an unsolicited URC - only ever comes
+	 * back on the one channel that asked, so it doesn't suffer this
+	 * duplication. The only cost is detecting a registration change
+	 * within ~2s instead of instantly. */
+	MODEM_CHAT_SCRIPT_CMD_RESP("AT+CEREG?", ok_match),
+	MODEM_CHAT_SCRIPT_CMD_RESP("AT+CGSN", imei_match), MODEM_CHAT_SCRIPT_CMD_RESP("", ok_match),
+	MODEM_CHAT_SCRIPT_CMD_RESP("AT+CGMM", cgmm_match), MODEM_CHAT_SCRIPT_CMD_RESP("", ok_match),
+	MODEM_CHAT_SCRIPT_CMD_RESP("AT+CGMI", cgmi_match), MODEM_CHAT_SCRIPT_CMD_RESP("", ok_match),
+	/* AT+CGMR: also doubles as this driver's firmware-version breadcrumb -
+	 * cgmr_match feeds CELLULAR_MODEM_INFO_FW_VERSION, which
+	 * srvNetwork.cpp logs on every connect() ("modem firmware version:
+	 * ..."). Useful for telling hardware apart after a vendor firmware
+	 * update, as happened here (see the CMUX history below). */
+	MODEM_CHAT_SCRIPT_CMD_RESP("AT+CGMR", cgmr_match), MODEM_CHAT_SCRIPT_CMD_RESP("", ok_match),
+	/* AT+CIMI removed: manual sec 3.10 (p.29) marks it the only one of
+	 * the five identity commands requiring RequireSIMCardNormal=Yes, and
+	 * documents its failure as a plain "ERROR" - the same zero-tolerance
+	 * abort_matches hit AT+CMEE=1 caused above, if the SIM isn't fully
+	 * ready yet (this script has no AT+CPIN? gate). Nothing reads
+	 * CELLULAR_MODEM_INFO_SIM_IMSI today, so dropping it costs nothing. */
+	/* Fibocom LE Series AT Commands User Manual V1.6 section 4.16: up to
+	 * 3 channels of CMUX multiplexing, basic mode, UIH frames only,
+	 * 115200 bps (port_speed=5, matching this UART's current speed), N1=127
+	 * to match Kconfig.cellular's MODEM_CMUX_DEFAULT_MTU_127 for this
+	 * driver.
+	 *
+	 * History: this exact command (and AT+CMUX=? alone, and AT+CMEE=1,
+	 * AT+CMEE=2, AT+CIMI - five documented-valid commands in total) all
+	 * failed with a fast, clean ERROR on this module's original firmware
+	 * (12007.7000.00.04.37.03), on every CFUN state tried, the same
+	 * "command doesn't actually exist on this firmware" signature
+	 * eventually confirmed for the sibling cellular_quectel_eg800z.c. A
+	 * Fibocom FAE provided updated firmware after being shown this
+	 * evidence, and AT+CMUX (full 4-parameter form, this exact line)
+	 * started working immediately: CMUX connects, DLCI1/2/3 all open,
+	 * AT+CGDCONT succeeds. Kept here, in this form, as the known-good
+	 * command for that firmware - if a module ever reports the older
+	 * firmware version again (see the AT+CGMR comment above), expect
+	 * this exact step to abort the script again. */
+	MODEM_CHAT_SCRIPT_CMD_RESP("AT+CMUX=0,0,5,127", ok_match));
+
+MODEM_CHAT_SCRIPT_DEFINE(fibocom_le270_init_chat_script, fibocom_le270_init_chat_script_cmds,
+			 abort_matches, modem_cellular_chat_callback_handler, 30);
+
+MODEM_CHAT_SCRIPT_CMDS_DEFINE(fibocom_le270_dial_chat_script_cmds,
+			      /* allow_match, not ok_match, on purpose: on this
+			       * network AT+CGACT=0,1 (best-effort "deactivate
+			       * context 1 before dialing, in case it's in a
+			       * stale state") reliably answers ERROR - observed
+			       * both "ue busy" and "Last PDN disconnection not
+			       * allowed" on real hardware - never OK. allow_match
+			       * treats that as expected and moves straight on;
+			       * this only misbehaves if CMEE is ever turned on
+			       * elsewhere (see the AT+CMEE note in the init
+			       * script above for why). */
+			      MODEM_CHAT_SCRIPT_CMD_RESP_MULT("AT+CGACT=0,1", allow_match),
+			      /* AT+CFUN=1 and the fixed 500ms "AT" settle that used
+			       * to sit here are both gone (removed 2026-10-05,
+			       * together with the init script's AT+CFUN=4 above):
+			       * since we never leave CFUN=1, there's no mode
+			       * switch left to settle after. Replaced with a real
+			       * AT+CEREG? read instead of a dead timer - this
+			       * does double duty: (1) it's the modem_comparison
+			       * report's suggested "CEREG check" in place of the
+			       * blind wait before ATD, and (2) it refreshes
+			       * modem_cellular_is_registered()'s cached
+			       * registration_status, instead of leaving it stale
+			       * from the init script's own early AT+CEREG? (sent
+			       * before CMUX/APN, likely before the attach above
+			       * has finished). That cache is exactly what
+			       * modem_cellular_on_await_registered_state_enter()
+			       * checks immediately on entry after a successful
+			       * dial - if it's already true, REGISTERED is
+			       * entered synchronously and net_if_dormant_off()
+			       * runs right away; otherwise the driver has to sit
+			       * idle for one full
+			       * CONFIG_MODEM_CELLULAR_PERIODIC_SCRIPT_MS (2000ms)
+			       * before the periodic script's own CEREG? read
+			       * updates it.
+			       *
+			       * NOTE: AT+CGACT=1,1 below sits between this read
+			       * and ATD, and can itself take real time completing
+			       * an attach - so by the time CONNECT arrives, this
+			       * particular read is no longer a guaranteed-fresh
+			       * snapshot. See the second AT+CEREG? read after
+			       * AT+CGACT=1,1 below (added 2026-10-06) for the one
+			       * that actually re-establishes that guarantee right
+			       * before ATD; this one mainly feeds the
+			       * registration-wait logic AT+CGACT=1,1 needs. */
+			      MODEM_CHAT_SCRIPT_CMD_RESP("AT+CEREG?", ok_match),
+			      /* Change 3, LE270_driver_optimisation_instructions.md:
+			       * wait for real registration before dialing instead of
+			       * trusting a single AT+CEREG? snapshot, so a slow cell
+			       * search (observed on real hardware - see the sibling
+			       * Joulescope report's "test 1" outlier, and this
+			       * project's own round where AT+CEREG? above read "0,2"
+			       * right before a 4.2s dial instead of the usual 0.2s)
+			       * fails cleanly on a timeout instead of just dialing
+			       * into an unregistered modem and hoping.
+			       *
+			       * Deliberately NOT implemented as the instructions
+			       * document's own suggested AT+CEREG=1 (enabling
+			       * unsolicited registration URCs): this project already
+			       * has a confirmed, hardware-verified bug report for
+			       * exactly that command on this module (see the
+			       * AT+CEREG=1 comment in the init script above) - it
+			       * broadcasts every +CEREG: URC identically on all three
+			       * open CMUX DLCIs, which previously raced the PPP
+			       * handover badly enough to break every connection.
+			       * Re-enabling it here to satisfy this change would
+			       * reintroduce that exact bug.
+			       *
+			       * AT+CGACT=1,1 (activate context 1) is the real gate
+			       * instead, sent with a hard ok_match (not allow_match
+			       * like the best-effort AT+CGACT=0,1 above): AT Commands
+			       * User Manual V1.6 sec 11.4 (p.184) documents that the
+			       * activation form, unlike the deactivation form above,
+			       * "If the MT is not PS attached when the activation
+			       * form of the command is executed, the MT first
+			       * performs a PS attach and then attempts to activate
+			       * the specified contexts. If the attach fails then the
+			       * MT responds with ERROR" - so this one command already
+			       * gives exactly what the instructions document asked
+			       * for: wait (up to its own documented 50s
+			       * MaxResponseDuration) for a real attach if one is
+			       * still needed, succeed immediately as a no-op if
+			       * context 1 is already active (same manual: "If any
+			       * PDP context is already in the requested state, the
+			       * state of that context remains unchanged" - matching
+			       * this project's normal case), or fail with ERROR if
+			       * attach genuinely fails. A failure here hits
+			       * dial_abort_matches like any other, so
+			       * modem_cellular's own existing retry logic
+			       * (MODEM_CELLULAR_MAX_SCRIPT_FAILURES=3, ~2s apart via
+			       * the periodic-script timer) already does the "retry,
+			       * then fail the round cleanly and shut down normally"
+			       * part - no new state-machine code needed. */
+			      MODEM_CHAT_SCRIPT_CMD_RESP("AT+CGACT=1,1", ok_match),
+			      /* Added 2026-10-06: root-caused why the very first
+			       * connection after an MCU reset consistently took
+			       * ~2s longer than every round after it, by reading
+			       * modem_cellular.c's state machine directly rather
+			       * than guessing. AT+CGACT=1,1 above can itself
+			       * complete a real attach (its documented behavior,
+			       * see the comment above it), but a successful
+			       * AT+CGACT response alone never updates
+			       * modem_cellular_is_registered()'s cached
+			       * registration_status - only a parsed "+CEREG:"
+			       * line does, and the one above was read *before*
+			       * AT+CGACT=1,1, so it can still be stale by the time
+			       * CONNECT arrives. On the very first connection since
+			       * boot this always bites: net_if's dormant flag
+			       * starts "on" (modem_ppp_ppp_api_init(), called once
+			       * at boot) and is only ever cleared by
+			       * modem_cellular_on_registered_state_enter()'s
+			       * net_if_dormant_off() - reached only once the cache
+			       * says registered. With the cache stale, the driver
+			       * falls back to waiting a full
+			       * CONFIG_MODEM_CELLULAR_PERIODIC_SCRIPT_MS (2000ms)
+			       * for its own periodic poll to refresh it, measured
+			       * on real hardware as an exact 2.000-2.01s gap
+			       * between CONNECT and the first PPP byte. Every round
+			       * after the first was never affected by this same
+			       * staleness, purely because the normal clean-suspend
+			       * path (REGISTERED's own SUSPEND handler) never turns
+			       * dormant back on - only the rare AWAIT_PPP_DEAD
+			       * recovery path does - so dormant simply stays off
+			       * for the rest of the session once any round clears
+			       * it, masking the bug rather than fixing it.
+			       *
+			       * This second AT+CEREG? read, immediately before
+			       * ATD, closes the gap directly: it refreshes the
+			       * cache right when modem_cellular_on_await_registered
+			       * _state_enter()'s immediate check needs it to be
+			       * fresh, regardless of whether dormant happens to
+			       * already be clear. Uses a hard ok_match like the
+			       * read above it - this is a plain query, not an
+			       * action command, so an ERROR here would be a real,
+			       * unexpected failure worth aborting on, not something
+			       * to tolerate. Adds one AT round-trip (~5-8ms,
+			       * consistent with every other plain AT+CEREG?/AT+CSQ
+			       * read in this driver's scripts) to every round;
+			       * removes the ~2s penalty specifically from whichever
+			       * round is first to actually need it. */
+			      MODEM_CHAT_SCRIPT_CMD_RESP("AT+CEREG?", ok_match),
+			      /* AT Commands User Manual V1.6 section 11.3
+			       * (D*99) documents ATD*99# as the plain form;
+			       * *99***1# additionally selects PDP context 1
+			       * (<cid>), matching AT+CGDCONT's default cid
+			       * that MODEM_CELLULAR configures. */
+			      MODEM_CHAT_SCRIPT_CMD_RESP("ATD*99***1#", connect_match));
+
+/* Timeout raised from the eg800q template's 10s, then again for Change 3
+ * above: modem_chat_script_start() schedules this as a single whole-script
+ * watchdog (never reset per step), and the manual's own documented
+ * MaxResponseDuration for this script's steps now sums to 113s worst case on
+ * paper (AT+CGACT=0,1 50000ms + AT+CEREG? 5000ms + AT+CGACT=1,1 50000ms +
+ * AT+CEREG? 5000ms + ATD*99***1# 3000ms - the second AT+CEREG? added
+ * 2026-10-06 above contributes another 5000ms) - still under the 120s
+ * budget below, with less margin than before. Past the old 90s budget this
+ * would be the same "whole script dies, CMUX/PPP never starts" failure as
+ * the AT+CMEE=1 abort, just via TIMEOUT instead of ABORT. 120s covers the
+ * documented worst case with margin, and matches
+ * CONFIG_FIREFLY_NETWORK_CONNECT_TIMEOUT_S (srvNetwork's own outer connect
+ * timeout) exactly, per the instructions document's own suggested range
+ * (60-120s) for this change. Real steps run in milliseconds in the normal
+ * case; MODEM_CELLULAR_MAX_SCRIPT_FAILURES (3 retries, ~2s apart) bounds how
+ * many times this 120s watchdog could theoretically be hit in a row before
+ * the framework gives up and runs the normal shutdown path - srvNetwork's
+ * own 120s connect_timeout is the ultimate backstop regardless of how
+ * modem_cellular's internal retry state behaves. */
+MODEM_CHAT_SCRIPT_DEFINE(fibocom_le270_dial_chat_script, fibocom_le270_dial_chat_script_cmds,
+			 dial_abort_matches, modem_cellular_chat_callback_handler, 120);
+
+MODEM_CHAT_SCRIPT_CMDS_DEFINE(fibocom_le270_periodic_chat_script_cmds,
+			      MODEM_CHAT_SCRIPT_CMD_RESP("AT+CEREG?", ok_match),
+			      MODEM_CHAT_SCRIPT_CMD_RESP("AT+CSQ", csq_match));
+
+/* Timeout raised from the eg800q template's 4s (same single whole-script
+ * watchdog as the dial script above): the manual documents
+ * MaxResponseDuration=5000ms for both AT+CEREG? and AT+CSQ, 10s combined
+ * worst case, already exceeding the old 4s budget on paper. */
+MODEM_CHAT_SCRIPT_DEFINE(fibocom_le270_periodic_chat_script,
+			 fibocom_le270_periodic_chat_script_cmds, abort_matches,
+			 modem_cellular_chat_callback_handler, 15);
+
+/* Added 2026-10-05, replacing "no .shutdown script" (see the removed comment
+ * this replaced, preserved in git history). Modem_comparison_nRF93M1_vs_
+ * LE270.docx section 6 measured the modem staying active for ~2.6-2.7s after
+ * CMUX/PPP teardown with NO shutdown script configured - an uncommanded,
+ * autonomous detach the modem only starts once it notices its AT/PPP
+ * channels have vanished - followed by a completely separate, much larger
+ * cost: modem_cellular.c's INIT_POWER_OFF, with no .shutdown script, falls
+ * straight to modem_cellular_begin_power_off_pulse() (power_off_pulse_
+ * duration_ms, 3100ms of PWRKEY held low) then AWAIT_POWER_OFF
+ * (shutdown_time_ms, 10000ms) before declaring the modem off - 13.1s fixed,
+ * even though the Joulescope trace shows modem current already at 0 well
+ * before either of those timers even finishes. Defining .scripts.shutdown
+ * changes this: per modem_cellular_run_shutdown_script_event_handler(),
+ * SCRIPT_SUCCESS here goes directly to IDLE, skipping the power pulse AND
+ * shutdown_time_ms entirely (same codepath cellular_quectel_eg800q.c already
+ * relies on for its AT+QPOWD). AT+CPWROFF is the Hardware Guide V2.2 sec 4.2
+ * documented power-off command - a real, commanded detach+power-off instead
+ * of letting the modem notice on its own, which is exactly what the report
+ * suggested ("send the power-off command on the AT DLCI"). It returns a bare
+ * OK with no completion URC (same doc, same section), so unlike EG800Z's
+ * "POWERED DOWN" match this can't confirm the modem has actually finished
+ * powering down - the trailing delay below exists for that reason.
+ *
+ * Delay tuned 2026-10-05 per LE270_driver_optimisation_instructions.md
+ * Change 2: a Joulescope trace showed modem current reaching 0 within
+ * 0.39-0.51s after AT+CPWROFF's OK on all 3 tests, but this delay was
+ * fixed at 3000ms (sized off an unrelated earlier data point - how long
+ * the modem stayed active with NO .shutdown script at all, not this
+ * command's own completion time). Checked both manuals for a documented
+ * minimum wait specifically after AT+CPWROFF's OK before cutting power -
+ * found none: the Hardware Guide V2.2 sec 4.2 only documents a timing
+ * requirement for the PWRKEY/hardware power-off method (>=5s after
+ * releasing PWRKEY before the next power-on), not AT+CPWROFF, and the AT
+ * Commands Manual's own +CPWROFF entry only documents MaxResponseDuration
+ * =3000ms (how long the OK itself may take to arrive, not a post-OK
+ * wait). Confirmed with the user: no LE270 status/V_INT pin is wired to
+ * an MCU GPIO on this board (can't detect power-off directly), so per
+ * the instructions document's own fallback for that case, dropped to
+ * 1000ms - roughly 2x the worst observed current-to-zero time, rather
+ * than inventing a number closer to the unrelated 3000ms/5000ms figures
+ * above. Flagged for hardware verification across multiple consecutive
+ * rounds (the instructions document's own acceptance criterion - 10
+ * consecutive clean boots, no SIM/flash errors) before trusting this
+ * long-term. */
+MODEM_CHAT_SCRIPT_CMDS_DEFINE(fibocom_le270_shutdown_chat_script_cmds,
+			      MODEM_CHAT_SCRIPT_CMD_RESP("AT+CPWROFF", ok_match),
+			      MODEM_CHAT_SCRIPT_CMD_RESP_NONE("", 1000));
+
+MODEM_CHAT_SCRIPT_DEFINE(fibocom_le270_shutdown_chat_script,
+			 fibocom_le270_shutdown_chat_script_cmds, abort_matches,
+			 modem_cellular_chat_callback_handler, 15);
+
+static const struct modem_cellular_vendor_config fibocom_le270_vendor = {
+	/* clang-format off */
+	.scripts = {
+		.init = &fibocom_le270_init_chat_script,
+		.dial = &fibocom_le270_dial_chat_script,
+		.periodic = &fibocom_le270_periodic_chat_script,
+		.shutdown = &fibocom_le270_shutdown_chat_script,
+	},
+	.unsol_matches = {
+		.matches = fibocom_le270_unsol,
+		.size = ARRAY_SIZE(fibocom_le270_unsol),
+	},
+	/* clang-format on */
+	/* Hardware Guide V2.2 section 4.2: power on needs PWRKEY pulled low
+	 * for >=650ms; hardware power off needs >=3.1s (3100ms) - too far
+	 * apart to share one duration without either a wastefully long
+	 * power-on pulse or a too-short power-off one. This pulse path is now
+	 * the fallback only (see .shutdown above) - still kept at the full
+	 * documented 3100ms, since it's the hard guarantee that cuts power
+	 * even if AT+CPWROFF ever stops responding. modem_cellular.h grew
+	 * a separate power_off_pulse_duration_ms field for exactly this split
+	 * (falls back to power_pulse_duration_ms when left at 0, so every
+	 * other vendor driver is unaffected) - see
+	 * zephyr/patches/zephyr/fibocom-le270-driver.patch. 700ms keeps
+	 * ~50ms margin above the documented 650ms power-on minimum without
+	 * needlessly extending how long the UART pipe stays unattached (see
+	 * the AWAIT_POWER_ON note on startup_time_ms below - the modem starts
+	 * transmitting almost immediately after PWRKEY drops, so a shorter
+	 * pulse means less of its early output is missed). */
+	.power_pulse_duration_ms = 700,
+	.power_off_pulse_duration_ms = 3100,
+	/* RESET_N held low for >=100ms per section 4.3; doubled for margin.
+	 * RESET_N isn't wired on this board (see boards/le270.overlay), so
+	 * MODEM_CELLULAR_STATE_RESET_PULSE - the only place this value drives
+	 * a real GPIO - is never entered for this instance; it only matters
+	 * here as the AWAIT_PPP_DEAD settle fallback a few lines of
+	 * commentary above this struct already documents (the
+	 * CEREG-duplication-race recovery path), which this change doesn't
+	 * touch. */
+	.reset_pulse_duration_ms = 200,
+	/* Change 5, LE270_driver_optimisation_instructions.md (2026-10-06):
+	 * real-hardware logs show a ~200ms fixed gap between "CMUX
+	 * disconnected" and AT+CPWROFF being sent - modem_cellular.c reused
+	 * reset_pulse_duration_ms (above) for this settle, but that value is
+	 * tied to the RESET_N pulse width spec, not to how long this UART
+	 * actually needs after CMUX teardown before un-multiplexed AT
+	 * commands are reliably accepted again. Split via the new
+	 * shutdown_cmux_settle_ms field (modem_cellular.h) instead of
+	 * shrinking reset_pulse_duration_ms itself, so the unrelated
+	 * AWAIT_PPP_DEAD recovery-path timing above is left exactly as
+	 * documented and verified. Document suggests 10-20ms; picked the top
+	 * of that range for margin on only the second LE270 ADP tested on.
+	 * Acceptance criterion: under 50ms between "CMUX disconnected" and
+	 * AT+CPWROFF OK - next hardware round confirms. Falls back to
+	 * reset_pulse_duration_ms (200ms, the pre-Change-5 behavior) if ever
+	 * set back to 0. */
+	.shutdown_cmux_settle_ms = 20,
+	/* Change 6, LE270_driver_optimisation_instructions.md (2026-10-06):
+	 * real hardware logs show a ~100ms fixed gap between AT+CMUX's OK and
+	 * the first CMUX SABM frame being sent - modem_cellular.c's generic
+	 * 100ms default exists for modems that disable UART RX while
+	 * switching into CMUX mode, but nothing in this driver's own history
+	 * has shown that symptom on this module. Document suggests trying
+	 * 20ms; picked the bottom of its suggested 10-20ms range since this
+	 * delay (unlike Change 5's shutdown settle) guards the one CMUX
+	 * handshake every round's dial path depends on - keep the original
+	 * 100ms (set this back to 0) if CMUX setup ever fails, even once, in
+	 * 20 rounds, per the document's own instruction. */
+	.cmux_connect_settle_ms = 20,
+	/* Not documented in the Hardware Guide (only the PWRKEY-pulse timing
+	 * diagrams are). History: 15000ms untested placeholder -> 2000ms after
+	 * the first hardware sample showed "AT" getting a clean OK in ~4.5ms
+	 * -> 1200ms after three more samples showed "AT command ready"/"+SIM
+	 * READY" consistently at 1.06s/1.43s, but the init script itself only
+	 * ever starting at the fixed 2.70s mark regardless.
+	 *
+	 * Change 4, LE270_driver_optimisation_instructions.md (2026-10-05):
+	 * that whole fixed-timer approach is now the FALLBACK, not the primary
+	 * mechanism - see fibocom_le270_unsol above, which wakes AWAIT_POWER_ON
+	 * on "AT command ready" directly instead of waiting out this timer.
+	 * Per the instructions document's own guidance ("keep the timer as a
+	 * timeout fallback, at 3s or the HDG's maximum boot time" - no HDG
+	 * boot-time figure exists, same gap as this field's own history),
+	 * raised back up to 3000ms: now that the URC is the fast path for the
+	 * normal case, this value only matters if "AT command ready" is ever
+	 * missed or garbled, so it can afford real margin instead of being
+	 * tuned tight against the fastest observed sample. */
+	.startup_time_ms = 3000,
+	/* Fallback-path-only since .shutdown above was added 2026-10-05: only
+	 * reached if AT+CPWROFF errors and modem_cellular falls back to the
+	 * power_off_pulse_duration_ms pulse. Was 10000ms, sized before any
+	 * hardware data existed; the same Joulescope traces that justified
+	 * .shutdown above show modem current reaching 0 well within the
+	 * power_off_pulse_duration_ms pulse itself, so this fallback-only
+	 * value no longer needs to carry the whole safety margin alone.
+	 * Dropped to 2000ms - still generous for a path that should now be
+	 * rare, without reintroducing a double-digit-second wait if it is
+	 * ever hit. */
+	.shutdown_time_ms = 2000,
+};
+
+/* One user pipe only, on DLCI 3: the AT Commands User Manual documents "up
+ * to 3 channels of CMUX multiplexing" for this series, one fewer than the
+ * 2-user-pipe template cellular_quectel_eg800q.c/eg800z.c use - stay inside
+ * that documented limit rather than assume it also covers a 4th DLCI. */
+#define MODEM_CELLULAR_DEVICE_FIBOCOM_LE270(inst)                                                 \
+	MODEM_DT_INST_PPP_DEFINE(inst, MODEM_CELLULAR_INST_NAME(ppp, inst), NULL, 98, 1500, 64);  \
+                                                                                                   \
+	static struct modem_cellular_data MODEM_CELLULAR_INST_NAME(data, inst) = {                \
+		.chat_delimiter = "\r",                                                           \
+		.chat_filter = "\n",                                                              \
+		.ppp = &MODEM_CELLULAR_INST_NAME(ppp, inst),                                      \
+	};                                                                                        \
+                                                                                                   \
+	MODEM_CELLULAR_DEFINE_AND_INIT_USER_PIPES(inst, (user_pipe_0, 3))                          \
+                                                                                                   \
+	MODEM_CELLULAR_DEFINE_INSTANCE(inst, &fibocom_le270_vendor)
+
+DT_INST_FOREACH_STATUS_OKAY(MODEM_CELLULAR_DEVICE_FIBOCOM_LE270)
