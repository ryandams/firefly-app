@@ -0,0 +1,13 @@
+description: Fibocom LE270 modem
+
+compatible: "fibocom,le270"
+
+include: zephyr,cellular-modem-device.yaml
+
+properties:
+  mdm-power-gpios:
+    type: phandle-array
+    required: true
+
+  zephyr,mdm-reset-behavior:
+    default: ["toggle_on_recovery"]
