diff --git a/drivers/modem/modem_cellular.c b/drivers/modem/modem_cellular.c
index bab3fc6a60d..1299245d7d4 100644
--- a/drivers/modem/modem_cellular.c
+++ b/drivers/modem/modem_cellular.c
@@ -1192,11 +1192,16 @@ static void modem_cellular_run_init_script_event_handler(struct modem_cellular_d

 static int modem_cellular_on_connect_cmux_state_enter(struct modem_cellular_data *data)
 {
+	const struct modem_cellular_config *config = data->dev->config;
+	const uint16_t settle_ms = (config->vendor->cmux_connect_settle_ms != 0)
+					    ? config->vendor->cmux_connect_settle_ms
+					    : 100;
+
 	/*
 	 * Allow modem to switch bus into CMUX mode. Some modems disable UART RX while
 	 * switching, resulting in UART RX errors as bus is no longer pulled up by modem.
 	 */
-	modem_cellular_start_timer(data, K_MSEC(100));
+	modem_cellular_start_timer(data, K_MSEC(settle_ms));
 	return 0;
 }

@@ -1876,10 +1881,13 @@ static int modem_cellular_on_run_shutdown_script_state_leave(struct modem_cellul
 static int modem_cellular_on_power_off_pulse_state_enter(struct modem_cellular_data *data)
 {
 	const struct modem_cellular_config *config = data->dev->config;
+	const uint16_t pulse_ms = (config->vendor->power_off_pulse_duration_ms != 0)
+					   ? config->vendor->power_off_pulse_duration_ms
+					   : config->vendor->power_pulse_duration_ms;

 	data->cmd_pipe = NULL;
 	gpio_pin_set_dt(&config->power_gpio, 1);
-	modem_cellular_start_timer(data, K_MSEC(config->vendor->power_pulse_duration_ms));
+	modem_cellular_start_timer(data, K_MSEC(pulse_ms));
 	return 0;
 }

diff --git a/include/zephyr/drivers/modem/modem_cellular.h b/include/zephyr/drivers/modem/modem_cellular.h
index aac7fd86b96..00f58a0bff2 100644
--- a/include/zephyr/drivers/modem/modem_cellular.h
+++ b/include/zephyr/drivers/modem/modem_cellular.h
@@ -287,6 +287,14 @@ struct modem_cellular_vendor_config {
 	} unsol_matches;
 	/** Duration of the modem power-key pulse, in milliseconds. */
 	uint16_t power_pulse_duration_ms;
+	/** Duration of the modem power-key pulse used for power-OFF, in milliseconds, if it
+	 * differs from @c power_pulse_duration_ms above. Defaults to @c power_pulse_duration_ms
+	 * if not specified (value == 0U). Some modems document meaningfully different minimum
+	 * PWRKEY pulse widths for power-on vs power-off, which a single shared duration can't
+	 * satisfy without either an unnecessarily long power-on pulse or a too-short,
+	 * unreliable power-off one.
+	 */
+	uint16_t power_off_pulse_duration_ms;
 	/** Duration of the modem reset pulse, in milliseconds. */
 	uint16_t reset_pulse_duration_ms;
 	/** Timeout for the modem to revert from CMUX to AT mode after a CMUX disconnect, in
@@ -294,6 +302,13 @@ struct modem_cellular_vendor_config {
 	 * legacy compatibility.
 	 */
 	uint16_t cmux_disconnect_timeout_ms;
+	/** Settle time after @c AT+CMUX's OK before sending the first CMUX SABM frame, in
+	 * milliseconds. Defaults to 100 if not specified (value == 0U), matching the behavior
+	 * before this field existed. Some modems disable UART RX while switching into CMUX mode
+	 * and need the full default; others settle faster and can use a shorter, per-vendor
+	 * value here instead of a global reduction of that default.
+	 */
+	uint16_t cmux_connect_settle_ms;
 	/** Maximum modem startup delay, in milliseconds. */
 	uint16_t startup_time_ms;
 	/** Maximum modem shutdown delay, in milliseconds. */
